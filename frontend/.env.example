# Origin of the Ktor backend. Next rewrites /api/* → ${BACKEND_ORIGIN}/*.
# Server-side only (read by next.config.ts at build and start).
BACKEND_ORIGIN=http://localhost:8080

# Public URL of this frontend (used for returnUrl in bookings/payments, links in UI).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk. Leave BOTH unset for local dev auth (backend must run AUTH_MODE=dev,
# APP_ENV=development). Set both to use Clerk sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# WebMCP: Chrome's and Edge's origin-trial tokens for this origin (https://developer.chrome.com/origintrials,
# https://developer.microsoft.com/microsoft-edge/origin-trials), sent on every page so agents
# in the browser can use their tools. Unset = only browsers with chrome://flags/#enable-webmcp-testing on.
WEBMCP_ORIGIN_TRIAL_TOKEN=
WEBMCP_EDGE_ORIGIN_TRIAL_TOKEN=

# Business MCP (members' own AI agents): on by default. Set to false together with the backend's BUSINESS_MCP_ENABLED
# kill switch, so the business agents guide isn't indexed, listed in the sitemap or linked from the customer guide.
NEXT_PUBLIC_BUSINESS_MCP_ENABLED=

# Bo, the business assistant, on the public pages: off unless true. Set it with the backend's ASSISTANT_ENABLED; off,
# the landing page tells owners to connect their own AI assistant to the business MCP instead.
NEXT_PUBLIC_ASSISTANT_ENABLED=

# Mobile app universal links / App Links (docs/mobile.md §6). Server-side, read per request (no rebuild needed).
# Unset = /.well-known/apple-app-site-association and /.well-known/assetlinks.json answer 404.
# iOS: comma-separated TEAMID.bundle.id (staging: V266333BR2.ie.bookanything.app.preview).
APPLE_APP_IDS=
# Android: the package (staging: ie.bookanything.app.preview) and its signing certificates' SHA-256 fingerprints,
# comma-separated AA:BB:... (upload key from `eas credentials`, app signing key from Play Console › App integrity).
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=

# Error tracking (Sentry; README "Error tracking (Sentry)"). Read at build time; unset DSN = no Sentry code at all.
# Environment: development | staging | production (default: production in a production build, else development).
# Release: the git sha of the build. Trace rate: 0-1, default 0 (errors only).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Source-map upload, only in the build that is deployed (CI secrets). Any of the three unset = no maps generated.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
