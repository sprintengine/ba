<configuration>
    <!-- LOG_FORMAT picks the appender (AppConfig refuses other values): logfmt (default) or json, one object per line for
         a log shipper (docs/observability.md). Request and business ids come from MDC in both. -->
    <appender name="logfmt" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>ts=%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%level logger=%logger{30} requestId=%X{requestId:--} businessId=%X{businessId:--} msg="%replace(%msg){'"','\\"'}"%n%ex</pattern>
        </encoder>
    </appender>

    <appender name="json" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.JsonEncoder">
            <withSequenceNumber>false</withSequenceNumber>
            <withNanoseconds>false</withNanoseconds>
            <withContext>false</withContext>
            <withThreadName>false</withThreadName>
            <withMessage>false</withMessage>
            <withArguments>false</withArguments>
            <withFormattedMessage>true</withFormattedMessage>
        </encoder>
    </appender>

    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="liquibase" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.testcontainers" level="WARN"/>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="${LOG_FORMAT:-logfmt}"/>
    </root>
</configuration>
