{
  "name": "@bookanything/simulation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scripted reliability simulation: seeded customer, owner and staff bots against a running stack, with invariant checks.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "sim": "tsx src/cli.ts run",
    "check-world": "tsx src/cli.ts check",
    "replay": "tsx src/cli.ts replay",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
