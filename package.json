{
  "name": "bookanything",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "backend:install": "./gradlew :backend:installDist",
    "backend:seed": "APP_ENV=development backend/build/install/backend/bin/backend seed-demo",
    "backend:dev": "APP_ENV=development AUTH_MODE=dev backend/build/install/backend/bin/backend",
    "backend:test": "./gradlew :backend:test",
    "backend:check": "./gradlew :backend:check",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:check": "npm --prefix frontend run format:check && npm --prefix frontend run lint && npm --prefix frontend run typecheck && npm --prefix frontend run test:coverage",
    "mobile:install": "npm --prefix mobile ci",
    "mobile:dev": "npm --prefix mobile run start",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:check": "npm --prefix mobile run check",
    "build": "npm --prefix frontend run build",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test": "npm run backend:check && npm run frontend:check && npm run mobile:check",
    "hooks:install": "git config core.hooksPath scripts/hooks",
    "test:scripts": "node --test 'scripts/**/*.test.mjs' 'deploy/**/*.test.mjs'"
  }
}
