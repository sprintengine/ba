# Copy to .env.local (git-ignored). Everything here is public: it ships inside the app.
# Expo loads .env files when the dev server or a build starts.

# Development: the API on the Mac that serves the bundle (http://<LAN IP>:<port>). Default port 8080.
# EXPO_PUBLIC_API_PORT=8080

# Any variant: a fixed API origin instead (staging, a tunnel).
# EXPO_PUBLIC_API_URL=https://api.staging.bookanything.ie

# Website origin (links we open in the browser, MCP server URLs). Development default: http://<LAN IP>:3000.
# EXPO_PUBLIC_WEB_URL=https://staging.bookanything.ie

# Clerk publishable key. Unset in development = dev sign-in (backend AUTH_MODE=dev).
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Build variant: development (default), preview or production (set per EAS profile in eas.json).
# APP_VARIANT=development
