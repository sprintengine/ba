# The API's settings on the VM: copy to backend.env (chmod 600) and fill in. No real values in the repository.
# Every variable is described in backend/README.md ("Configuration"); this is what a deployment sets.

# production or staging. Staging applies every production rule (no dev auth, dev payments, seed or fake model) and
# only differs in its name, which logs and error tracking carry.
APP_ENV=production

# The website's origin (emails, manage links, OAuth issuer, MCP resource URLs).
APP_BASE_URL=https://bookanything.example

# Postgres. Use the provider's DIRECT endpoint, not a transaction-mode pooler: the API sets session settings
# (statement timeouts) and holds session advisory locks. TLS is required.
DATABASE_URL=jdbc:postgresql://db-host.example:5432/bookanything?sslmode=require
# The application role: an ordinary role without BYPASSRLS, so row-level security applies (deploy/sql/app-role.sql).
DATABASE_USERNAME=bookanything_app
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=10

# HMAC key for manage links and invitations (32+ random characters: `openssl rand -base64 48`). Rotating it
# invalidates outstanding links.
TOKEN_SECRET=

# Clerk (production instance for production, its own development or production instance for staging).
CLERK_ISSUER=https://clerk.bookanything.example
CLERK_AUTHORIZED_PARTIES=https://bookanything.example
CLERK_WEBHOOK_SECRET=
CLERK_ACCEPT_NATIVE_SESSIONS=false

# Behind Cloudflare: the edge sets CF-Connecting-IP on every request to the client's address, and cloudflared (on the
# Docker network, a trusted private address) is the API's only peer. Rate limits key on it.
CLIENT_IP_HEADER=CF-Connecting-IP

# Stripe (test keys on staging).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Email (Resend) and SMS (Twilio). Without them email is only logged and SMS is off.
RESEND_API_KEY=
EMAIL_FROM=bookanything <bookings@bookanything.example>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Push to the mobile app.
PUSH_NOTIFICATIONS=off
EXPO_ACCESS_TOKEN=

# AI (the business draft, and Bo when ASSISTANT_ENABLED is on). With a key, staging and production refuse to start without the four credit settings:
# what an AI credit is worth (model list-price cost per credit, in micro-cents) and each plan's monthly credits
# (backend/README.md, "AI usage metering and credits").
ANTHROPIC_API_KEY=
AI_CREDIT_MICRO_CENTS=
AI_CREDITS_FREE=
AI_CREDITS_PRO=
AI_CREDITS_BUSINESS=
# Bo, the business assistant: off unless true (owners connect their own AI assistant to the business MCP instead).
# Build the website with NEXT_PUBLIC_ASSISTANT_ENABLED to match (the {STAGING,PRODUCTION}_ASSISTANT_ENABLED variable).
ASSISTANT_ENABLED=false

# Uploaded images in Cloudflare R2 (S3 API). The key needs Object Read & Write on this bucket only; the bucket is
# public at STORAGE_PUBLIC_BASE_URL (a custom domain on the bucket).
STORAGE_S3_BUCKET=bookanything-uploads
STORAGE_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=https://uploads.bookanything.example

# Geocoding for the marketplace (optional; a built-in table of Irish places otherwise).
MAPBOX_ACCESS_TOKEN=

LOG_LEVEL=INFO
