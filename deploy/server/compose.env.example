# Compose and updater settings for the VM's deploy directory: copy to .env (chmod 600). No real values in the
# repository.

# The image to follow (ghcr.io/<owner>/bookanything-backend) and this environment's tag, staging or production: the
# release train moves the tag (docs/releases.md) and update.sh deploys whatever it names. Empty: nothing is deployed.
BACKEND_REPOSITORY=
TRACK=

# Written by deploy.sh: the digest running now. Leave empty on a new VM.
BACKEND_IMAGE=

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > "Install connector": the token after `--token`.
CLOUDFLARE_TUNNEL_TOKEN=

# Memory limit per backend container. Two run together for a few seconds during a deploy: on a 4 GB VM, 1g each
# leaves room for cloudflared and the OS. JAVA_OPTS in backend/Dockerfile sizes the JVM from this.
BACKEND_MEMORY=1g

# Optional: pin a different cloudflared release.
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.7
